{
  "name": "afreemail-desktop",
  "version": "0.1.3",
  "description": "AFreeMail desktop shell -- an Electron app that bundles a real copy of afreemail-web (mail, settings, Contribion) so it opens instantly with no internet connection, talking to the real backend only for data. No marketing/legal/docs pages ship in the app bundle since the shell never navigates to them.",
  "private": true,
  "author": "AFreeMail",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:web": "rm -rf src/web-dist && mkdir -p src/web-dist && npm run build --prefix ../afreemail-web && cp -r ../afreemail-web/dist/. src/web-dist/",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "release": "electron-builder --mac --win --linux --publish always",
    "release:mac": "electron-builder --mac --publish always"
  },
  "dependencies": {
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.afreemail.desktop",
    "productName": "AFreeMail",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Emplug",
      "repo": "afreemail-desktop",
      "releaseType": "release"
    },
    "afterSign": "src/notarize.js",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Network",
      "icon": "build/icon.png"
    }
  }
}
